{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
	"baseBranchPatterns": ["staging"],
	"timezone": "Europe/Berlin",
	"schedule": ["before 7am on the first day of the month"],
	"minimumReleaseAge": "3 days",
	"prConcurrentLimit": 3,
	"packageRules": [
		{
			"description": "All patch/minor updates in one PR",
			"matchUpdateTypes": ["patch", "minor"],
			"groupName": "non-major"
		},
		{
			"description": "Majors only after approval in the Dependency Dashboard",
			"matchUpdateTypes": ["major"],
			"dependencyDashboardApproval": true
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": ["@sveltejs/**", "svelte", "svelte-check", "vite"],
			"groupName": "sveltekit"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": [
				"eslint",
				"@eslint/**",
				"typescript-eslint",
				"eslint-plugin-svelte",
				"svelte-eslint-parser",
				"eslint-config-prettier",
				"globals"
			],
			"groupName": "eslint"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": ["prettier", "prettier-plugin-*"],
			"groupName": "prettier"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": [
				"tailwindcss",
				"@tailwindcss/**",
				"tailwind-merge",
				"tailwind-variants",
				"tailwindcss-animate",
				"lightningcss",
				"lightningcss-*"
			],
			"groupName": "tailwind"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": ["bits-ui", "mode-watcher", "svelte-sonner", "lucide-svelte"],
			"groupName": "ui components"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": ["semantic-release", "@semantic-release/**", "@commitlint/**"],
			"groupName": "release tooling"
		},
		{
			"matchUpdateTypes": ["major"],
			"matchPackageNames": ["typescript"],
			"groupName": "typescript"
		}
	]
}
