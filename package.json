{
	"name": "kiezbox-pwa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "node scripts/prepare-city.js",
		"dev": "vite dev",
		"prebuild": "node scripts/prepare-city.js",
		"build": "vite build",
		"postbuild": "node scripts/check-size.js",
		"preview": "vite preview",
		"check": "node scripts/prepare-city.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node scripts/prepare-city.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"deploy": "npm run build && dotenv ./deploy.sh",
		"build:city": "dotenv -e .env.$CITY -- npm run build",
		"deploy:city": "dotenv -e .env.$CITY -- sh -c 'npm run build && ./deploy.sh'"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*",
		"@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
		"lightningcss-linux-x64-gnu": "^1.30.1"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"lucide-svelte": "^0.483.0",
		"mode-watcher": "^0.5.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^2.6.1",
		"tailwind-variants": "^0.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"carbon-icons-svelte": "^13.15.0",
		"dotenv": "^16.6.1",
		"maplibre-gl": "^6.11.1",
		"sip.js": "^0.21.2",
		"sveltekit-i18n": "^2.4.2",
		"tailwindcss-animate": "^1.0.7"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}
